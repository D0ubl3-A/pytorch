  "specific_operators": {
    "torch.add": ["add_test.py", "binary_test.py"],
    "torch.matmul": ["matmul_test.py"],
    "torch.mm": ["mm_test.py"],
    "torch.bmm": ["bmm_test.py"],
    "torch.addmm": ["addmm_test.py"],
    "torch.conv2d": ["conv_test.py"],
    "torch.batch_norm": ["batchnorm_test.py"],
    "torch.layer_norm": ["layernorm_test.py"],
    "torch.group_norm": ["groupnorm_test.py"],
    "torch.relu": ["activation_test.py"],
    "torch.gelu": ["gelu_test.py"],
    "torch.sigmoid": ["activation_test.py"],
    "torch.softmax": ["softmax_test.py"],
    "torch.cat": ["cat_test.py"],
    "torch.stack": ["stack_test.py"],
    "torch.gather": ["gather_test.py"],
    "torch.index_select": ["index_select_test.py"],
    "torch.sum": ["sum_test.py"],
    "torch.topk": ["topk_test.py"],
    "torch.embedding": ["embeddingbag_test.py"],
    "torch.nn.Linear": ["linear_test.py", "matmul_test.py"],
    "F.scaled_dot_product_attention": ["attention_test.py"]
  },
  "infrastructure": {
    "dispatcher": {
      "description": "ATen dispatcher and operator registration",
      "file_patterns": [
        "aten/src/ATen/core/*",
        "*Dispatch*",
        "*dispatch*",
        "*Registry*"
      ],
      "benchmarks": "all_short",
      "priority": "critical",
      "rationale": "Dispatcher changes affect all operators"
    },
    "autograd": {
      "description": "Automatic differentiation engine",
      "file_patterns": [
        "torch/csrc/autograd/*",
        "*Autograd*",
        "*autograd*"
      ],
      "benchmarks": "all_short",
      "priority": "high",
      "rationale": "Autograd changes can affect all differentiable operations"
    },
    "jit": {
      "description": "TorchScript JIT compiler",
      "file_patterns": [
        "torch/csrc/jit/*",
        "*jit/*"
      ],
      "benchmarks": "all_short",
      "priority": "medium",
      "rationale": "JIT changes may affect operator performance in traced/scripted models"
    },
    "cuda_backend": {
      "description": "CUDA backend infrastructure",
      "file_patterns": [
        "c10/cuda/*",
        "aten/src/ATen/cuda/CUDAContext*",
        "aten/src/ATen/cuda/CUDABlas*"
      ],
      "benchmarks": "cuda_benchmarks",
      "priority": "high",
      "rationale": "CUDA backend changes affect all GPU operators"
    },
    "cpu_backend": {
      "description": "CPU backend infrastructure",
      "file_patterns": [
        "aten/src/ATen/native/cpu/*",
        "aten/src/ATen/cpu/*"
      ],
      "benchmarks": "cpu_benchmarks",
      "priority": "high",
      "rationale": "CPU backend changes affect all CPU operators"
    }
  },
  "exclusions": {
    "documentation": {
      "file_patterns": [
        "*.md",
        "*.rst",
        "docs/*"
      ],
      "benchmarks": "none",
      "rationale": "Documentation changes do not affect performance"
    },
    "tests": {
      "file_patterns": [
        "test/*",
        "*_test.py"
      ],
      "benchmarks": "none",
      "rationale": "Test-only changes do not affect runtime performance",
      "exceptions": [
        "benchmarks/operator_benchmark/*"
      ]
    },
    "ci_configs": {
      "file_patterns": [
        ".github/workflows/*",
        ".ci/*",
        "*.yml",
        "*.yaml"
      ],
      "benchmarks": "none",
      "rationale": "CI configuration changes do not affect operator performance",
      "exceptions": [
        "Build configuration changes that affect optimization flags"
      ]
    },
    "tooling": {
      "file_patterns": [
        "tools/*",
        "scripts/*"
      ],
      "benchmarks": "none",
      "rationale": "Tooling changes do not affect runtime performance",
      "exceptions": [
        "Codegen changes that affect generated kernels"
      ]
    }
  },
  "benchmark_scopes": {
    "none": {
      "description": "No benchmarks needed",
      "tag_filter": null,
      "estimated_time": "0 minutes"
    },
    "targeted": {
      "description": "Run specific benchmarks for affected operators only",
      "tag_filter": "short",
      "max_benchmarks": 10,
      "estimated_time": "5-10 minutes per device"
    },
    "short": {
      "description": "Run all short-tagged benchmarks (common operators)",
      "tag_filter": "short",
      "estimated_time": "15-30 minutes per device"
    },
    "long": {
      "description": "Run all benchmarks including long-tagged tests",
      "tag_filter": "all",
      "estimated_time": "2-4 hours per device"
    },
    "full": {
      "description": "Run comprehensive benchmarks across all devices",
      "tag_filter": "all",
      "devices": ["cpu_x86_64", "cpu_aarch64", "cuda_h100", "cuda_a100", "rocm_mi300"],
      "estimated_time": "8-12 hours"
    }
  }
}
