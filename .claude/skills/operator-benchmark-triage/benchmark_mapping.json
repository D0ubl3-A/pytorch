{
  "description": "Mapping of code paths/patterns to operator benchmark tests",
  "version": "1.0",
  "last_updated": "2026-04-24",
  "categories": {
    "linear_algebra": {
      "description": "Matrix operations including matmul, mm, bmm, addmm",
      "file_patterns": [
        "*matmul*",
        "*LinearAlgebra*",
        "*blas*",
        "*gemm*",
        "aten/src/ATen/native/cpu/BlasKernel.cpp",
        "aten/src/ATen/native/cuda/Blas.cpp"
      ],
      "benchmarks": [
        "matmul_test.py",
        "mm_test.py",
        "bmm_test.py",
        "addmm_test.py",
        "scaled_mm_test.py",
        "scaled_grouped_mm_test.py"
      ],
      "priority": "critical"
    },
    "convolution": {
